# GEMINI_API_KEY: Required for Gemini AI API calls (Vision Crop Inspection & Voice Assistant)
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: Host URL of the deployed application
APP_URL="http://localhost:3000"

# MONGODB_URI: MongoDB cluster or local connection string for persistent MERN database storage
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/agriverse?retryWrites=true&w=majority"

# JWT_SECRET: Secret key for signing and verifying JSON Web Tokens
JWT_SECRET="your_secure_jwt_secret_key_here"

# RAZORPAY PAYMENT GATEWAY: Server-side credentials for live/test Razorpay Orders & Signature Verification
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# CASHFREE / CASHPAY PAYMENT GATEWAY: Server-side credentials for Cashfree PG v2023-08-01 Orders
CASHFREE_APP_ID="your_cashfree_app_id_here"
CASHFREE_SECRET_KEY="your_cashfree_secret_key_here"
CASHFREE_ENV="sandbox"

# PORT: Server port (defaults to 3000)
PORT=3000
